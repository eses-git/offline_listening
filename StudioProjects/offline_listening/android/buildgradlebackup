group = "com.example.offline_listening"
version = "1.0-SNAPSHOT"

buildscript {
    ext.kotlin_version = "1.8.22"
    repositories {
        google()
        mavenCentral() // Ensure Maven Central is included
    }
    dependencies {
        classpath("com.android.tools.build:gradle:8.4.0") // Gradle plugin version for Gradle 8.4
        classpath("org.jetbrains.kotlin:kotlin-gradle-plugin:$kotlin_version") // Kotlin plugin
    }
}

allprojects {
    repositories {
        google()
        mavenCentral()
        maven { url 'https://jitpack.io' } // Ensure JitPack is available as fallback
    }
}

apply plugin: "com.android.library"
apply plugin: "kotlin-android"

android {
    namespace = "com.example.offline_listening"
    compileSdk = 34
    ndkVersion "27.0.12077973"
    defaultConfig {
        minSdk = 21
        targetSdk = 34 // Ensure the target SDK matches the compile SDK
        ndk {
            abiFilters  'armeabi-v7a', 'arm64-v8a'
        }
        // Add or update this line

    }
    sourceSets {
        main {
            jniLibs.srcDirs = ['src/main/jniLibs']
            java.srcDirs += "src/main/kotlin"
        }
    }
    packagingOptions {
        pickFirst 'lib/armeabi-v7a/libjnijavacpp.so'
        pickFirst 'lib/arm64-v8a/libjnijavacpp.so'
        pickFirst 'lib/x86/libjnijavacpp.so'
        pickFirst 'lib/x86_64/libjnijavacpp.so'
        pickFirst 'lib/armeabi-v7a/libjnitensorflowlite.so'
        pickFirst 'lib/arm64-v8a/libjnitensorflowlite.so'
        pickFirst 'lib/x86/libjnitensorflowlite.so'
        pickFirst 'lib/x86_64/libjnitensorflowlite.so'
    }
    sourceSets {
        main {
            jniLibs.srcDirs = ['src/main/jniLibs'] // Ensure custom .so files are included
        }
    }
    compileOptions {
        sourceCompatibility = JavaVersion.VERSION_17 // Gradle 8.4+ requires Java 17
        targetCompatibility = JavaVersion.VERSION_17
    }

    kotlinOptions {
        jvmTarget = "17" // Kotlin requires compatibility with Java 17
    }

    sourceSets {
        main {
            java.srcDirs += "src/main/kotlin"
        //    resources.srcDirs += "libs"
        }
    }

    testOptions {
        unitTests.all {
            useJUnitPlatform() // Enable JUnit platform
            testLogging {
                events "passed", "skipped", "failed", "standardOut", "standardError"
                showStandardStreams = true
            }
        }
    }
}

dependencies {
    // Include all .jar files in the 'libs' directory

    // TensorFlow Lite for Android
   // implementation 'org.tensorflow:tensorflow-lite:2.16.1'
   // implementation 'org.tensorflow:tensorflow-lite-select-tf-ops:2.16.1'
    ///implementation 'org.tensorflow:tensorflow-lite-gpu:2.16.1'

    implementation 'org.bytedeco:tensorflow-lite:2.18.0-1.5.11'
    implementation 'org.bytedeco:tensorflow-lite-platform:2.18.0-1.5.11'

    //  implementation 'org.bytedeco:javacpp:1.5.11'
    implementation 'org.tensorflow:tensorflow-lite-metadata:0.4.4'
   // implementation 'org.bytedeco:tensorflow-lite:2.18.0-1.5.11'
    //

    //implementation 'org.openimaj:JTransforms:1.3.10'
   // implementation 'com.github.rwl:jtransforms:2.4.0'
    implementation 'com.github.wendykierp:JTransforms:3.1'

    implementation "androidx.core:core:1.9.0"

    // Kotlin Standard Library
   // implementation "org.jetbrains.kotlin:kotlin-stdlib:$kotlin_version"
    implementation 'org.jetbrains.kotlin:kotlin-stdlib:1.8.22'
    implementation 'org.jetbrains.kotlinx:kotlinx-coroutines-android:1.7.3'
    // Testing Libraries
    testImplementation("org.jetbrains.kotlin:kotlin-test")
    testImplementation("org.mockito:mockito-core:5.0.0")


    //-----------extra------------------

}
